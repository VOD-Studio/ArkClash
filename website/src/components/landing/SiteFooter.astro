---
import { withBase } from '../../lib/paths';
import meta from '../../generated/meta.json';
---

<footer class="border-t py-14" style="border-color: var(--ark-border);">
  <div class="mx-auto max-w-6xl px-5 sm:px-8">
    <div class="grid grid-cols-1 gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <div>
        <a
          href={withBase('/')}
          class="inline-flex items-center gap-2.5 text-base font-semibold tracking-[-0.02em] no-underline"
          style="color: var(--ark-ink);"
        >
          <img
            src={withBase('/assets/icon.png')}
            alt="ArkClash"
            width="28"
            height="28"
            class="h-7 w-7 rounded-[7px]"
          />
          <span>ArkClash</span>
        </a>
        <p class="mt-3.5 text-sm leading-relaxed" style="color: var(--ark-ink-muted);">
          基于 mihomo 的原生 HarmonyOS NEXT 代理客户端，以 GPL-3.0 协议开源。
        </p>
      </div>

      <div>
        <div class="text-xs font-semibold tracking-wider uppercase" style="color: var(--ark-ink);">
          用户文档
        </div>
        <ul class="mt-3.5 space-y-2.5 text-sm">
          <li>
            <a href={withBase('/getting-started/introduction/')} class="no-underline hover:underline" style="color: var(--ark-ink-muted);">
              快速开始
            </a>
          </li>
          <li>
            <a href={withBase('/getting-started/installation/')} class="no-underline hover:underline" style="color: var(--ark-ink-muted);">
              安装与签名
            </a>
          </li>
          <li>
            <a href={withBase('/guide/profiles/')} class="no-underline hover:underline" style="color: var(--ark-ink-muted);">
              配置与订阅
            </a>
          </li>
          <li>
            <a href={withBase('/advanced/overrides/')} class="no-underline hover:underline" style="color: var(--ark-ink-muted);">
              进阶覆写与规则
            </a>
          </li>
        </ul>
      </div>

      <div>
        <div class="text-xs font-semibold tracking-wider uppercase" style="color: var(--ark-ink);">
          开发与架构
        </div>
        <ul class="mt-3.5 space-y-2.5 text-sm">
          <li>
            <a href={withBase('/developer/architecture/')} class="no-underline hover:underline" style="color: var(--ark-ink-muted);">
              系统架构
            </a>
          </li>
          <li>
            <a href={withBase('/developer/platform-pitfalls/')} class="no-underline hover:underline" style="color: var(--ark-ink-muted);">
              鸿蒙平台陷阱
            </a>
          </li>
          <li>
            <a href={withBase('/developer/adr/')} class="no-underline hover:underline" style="color: var(--ark-ink-muted);">
              架构决策记录（{meta.adrCount}）
            </a>
          </li>
          <li>
            <a href={withBase('/developer/changelog/')} class="no-underline hover:underline" style="color: var(--ark-ink-muted);">
              更新日志
            </a>
          </li>
        </ul>
      </div>

      <div>
        <div class="text-xs font-semibold tracking-wider uppercase" style="color: var(--ark-ink);">
          社区与致谢
        </div>
        <ul class="mt-3.5 space-y-2.5 text-sm">
          <li>
            <a href={meta.repoUrl} target="_blank" rel="noopener noreferrer" class="no-underline hover:underline" style="color: var(--ark-ink-muted);">
              GitHub 仓库 ↗
            </a>
          </li>
          <li>
            <a href={meta.releasesUrl} target="_blank" rel="noopener noreferrer" class="no-underline hover:underline" style="color: var(--ark-ink-muted);">
              最新版本下载 ↗
            </a>
          </li>
          <li>
            <a href={withBase('/developer/security/')} class="no-underline hover:underline" style="color: var(--ark-ink-muted);">
              安全策略
            </a>
          </li>
          <li class="text-xs leading-relaxed" style="color: var(--ark-ink-soft);">
            致谢 mihomo · FlClash · sing-tun · gVisor · meta-rules-dat
          </li>
        </ul>
      </div>
    </div>

    <div
      class="mt-12 flex flex-col justify-between gap-3 border-t pt-6 text-xs sm:flex-row sm:items-center"
      style="border-color: var(--ark-border); color: var(--ark-ink-soft);"
    >
      <p>
        © {new Date().getFullYear()} VOD-Studio · 依据{' '}
        <a
          href={`${meta.repoUrl}/blob/main/LICENSE`}
          target="_blank"
          rel="noopener noreferrer"
          class="underline-offset-2 hover:underline"
          style="color: var(--ark-ink-muted);"
        >
          GPL-3.0
        </a>{' '}
        许可证开源。
      </p>
      <p>本项目仅用于学习和研究网络技术，请遵守所在地区法律法规。</p>
    </div>
  </div>
</footer>
