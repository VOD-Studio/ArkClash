@@ -0,0 +1,200 @@
+package tunnel
+
+import (
+	"context"
+	"errors"
+	"net"
+	"sync"
+
+	N "github.com/metacubex/mihomo/common/net"
+	C "github.com/metacubex/mihomo/constant"
+)
+
+type arkClashForwardingGeneration struct {
+	ctx context.Context
+	cancel context.CancelFunc
+	tasks sync.WaitGroup
+	mu sync.Mutex
+	closed bool
+	resources map[*arkClashForwardingResource]struct{}
+	err error
+}
+
+type arkClashForwardingResource struct {
+	generation *arkClashForwardingGeneration
+	close func() error
+	once sync.Once
+	err error
+}
+
+var arkClashForwarding struct {
+	operations sync.Mutex
+	mu sync.Mutex
+	enabled bool
+	current *arkClashForwardingGeneration
+	err error
+}
+
+// ArkClashSuspendForwarding 先封住准入，再取消、关闭并等待本代转发；不包含独立 URLTest。
+// 调用期间不得持有转发 worker 需要回调取得的锁；本注册表不回调 ArkClash 核心。
+func ArkClashSuspendForwarding() error {
+	arkClashForwarding.operations.Lock()
+	defer arkClashForwarding.operations.Unlock()
+	arkClashForwarding.mu.Lock()
+	arkClashForwarding.enabled = true
+	generation := arkClashForwarding.current
+	arkClashForwarding.current = nil
+	arkClashForwarding.mu.Unlock()
+	if generation != nil {
+		generation.cancel()
+		generation.mu.Lock()
+		generation.closed = true
+		resources := make([]*arkClashForwardingResource, 0, len(generation.resources))
+		for resource := range generation.resources {
+			resources = append(resources, resource)
+		}
+		generation.mu.Unlock()
+		for _, resource := range resources {
+			_ = resource.Close()
+		}
+		generation.tasks.Wait()
+		generation.mu.Lock()
+		arkClashForwarding.err = errors.Join(arkClashForwarding.err, generation.err)
+		generation.mu.Unlock()
+	}
+	return arkClashForwarding.err
+}
+
+func ArkClashResumeForwarding() {
+	arkClashForwarding.operations.Lock()
+	defer arkClashForwarding.operations.Unlock()
+	arkClashForwarding.mu.Lock()
+	defer arkClashForwarding.mu.Unlock()
+	arkClashForwarding.enabled = true
+	if arkClashForwarding.current == nil {
+		ctx, cancel := context.WithCancel(context.Background())
+		arkClashForwarding.current = &arkClashForwardingGeneration{
+			ctx: ctx, cancel: cancel,
+			resources: make(map[*arkClashForwardingResource]struct{}),
+		}
+		arkClashForwarding.err = nil
+	}
+}
+
+func arkClashAdmitForwarding() (*arkClashForwardingGeneration, bool) {
+	arkClashForwarding.mu.Lock()
+	defer arkClashForwarding.mu.Unlock()
+	if !arkClashForwarding.enabled {
+		return nil, true
+	}
+	generation := arkClashForwarding.current
+	if generation == nil {
+		return nil, false
+	}
+	// Add 与关闭准入共用锁；子任务只能由尚未 Done 的已准入任务派生。
+	generation.tasks.Add(1)
+	return generation, true
+}
+
+func (g *arkClashForwardingGeneration) context() context.Context {
+	if g == nil {
+		return context.Background()
+	}
+	return g.ctx
+}
+
+func (g *arkClashForwardingGeneration) done() {
+	if g != nil {
+		g.tasks.Done()
+	}
+}
+
+func (g *arkClashForwardingGeneration) fork() {
+	if g != nil {
+		g.tasks.Add(1)
+	}
+}
+
+func (g *arkClashForwardingGeneration) recordError(err error) {
+	if g == nil || err == nil || errors.Is(err, net.ErrClosed) {
+		return
+	}
+	g.mu.Lock()
+	g.err = errors.Join(g.err, err)
+	g.mu.Unlock()
+}
+
+func (g *arkClashForwardingGeneration) own(close func() error) *arkClashForwardingResource {
+	resource := &arkClashForwardingResource{generation: g, close: close}
+	g.mu.Lock()
+	closed := g.closed
+	if !closed {
+		g.resources[resource] = struct{}{}
+	}
+	g.mu.Unlock()
+	if closed {
+		_ = resource.Close()
+	}
+	return resource
+}
+
+func (r *arkClashForwardingResource) Close() error {
+	r.once.Do(func() {
+		r.err = r.close()
+		r.generation.recordError(r.err)
+		r.generation.mu.Lock()
+		delete(r.generation.resources, r)
+		r.generation.mu.Unlock()
+	})
+	return r.err
+}
+
+type arkClashForwardingConn struct {
+	C.Conn
+	resource *arkClashForwardingResource
+}
+
+func (c *arkClashForwardingConn) Close() error { return c.resource.Close() }
+func (c *arkClashForwardingConn) Upstream() any { return c.Conn }
+func (c *arkClashForwardingConn) ReaderReplaceable() bool { return true }
+func (c *arkClashForwardingConn) WriterReplaceable() bool { return true }
+
+func arkClashOwnForwardingConn(g *arkClashForwardingGeneration, conn C.Conn) C.Conn {
+	if g == nil {
+		return conn
+	}
+	return &arkClashForwardingConn{Conn: conn, resource: g.own(conn.Close)}
+}
+
+type arkClashForwardingPacketConn struct {
+	C.PacketConn
+	resource *arkClashForwardingResource
+}
+
+func (c *arkClashForwardingPacketConn) Close() error { return c.resource.Close() }
+func (c *arkClashForwardingPacketConn) Upstream() any { return c.PacketConn }
+func (c *arkClashForwardingPacketConn) ReaderReplaceable() bool { return true }
+func (c *arkClashForwardingPacketConn) WriterReplaceable() bool { return true }
+
+func arkClashOwnForwardingPacketConn(g *arkClashForwardingGeneration, conn C.PacketConn) C.PacketConn {
+	if g == nil {
+		return conn
+	}
+	return &arkClashForwardingPacketConn{PacketConn: conn, resource: g.own(conn.Close)}
+}
+
+type arkClashForwardingLocalConn struct {
+	N.ExtendedConn
+	resource *arkClashForwardingResource
+}
+
+func (c *arkClashForwardingLocalConn) Close() error { return c.resource.Close() }
+func (c *arkClashForwardingLocalConn) Upstream() any { return c.ExtendedConn }
+func (c *arkClashForwardingLocalConn) ReaderReplaceable() bool { return true }
+func (c *arkClashForwardingLocalConn) WriterReplaceable() bool { return true }
+
+// 代次随队列元素按值传递，不给每个 UDP 包分配额外包装对象。
+type arkClashUDPPacket struct {
+	packet C.PacketAdapter
+	generation *arkClashForwardingGeneration
+}
