+package resolver
+
+import (
+	"context"
+	"net"
+	"sync"
+)
+
+type requestContextKey struct{}
+
+type requestContextState struct {
+	ctx context.Context
+	cancel context.CancelFunc
+	mu sync.Mutex
+	closed bool
+	tasks sync.WaitGroup
+}
+
+// WithRequestContext 只给内置请求使用；释放时先取消，再等待它派生的 DNS 工作结束。
+func WithRequestContext(ctx context.Context) (context.Context, func()) {
+	ctx, cancel := context.WithCancel(ctx)
+	state := &requestContextState{cancel: cancel}
+	ctx = context.WithValue(ctx, requestContextKey{}, state)
+	state.ctx = ctx
+	state.tasks.Add(1)
+	return ctx, func() {
+		state.mu.Lock()
+		state.closed = true
+		cancel()
+		state.mu.Unlock()
+		state.tasks.Done()
+		state.tasks.Wait()
+	}
+}
+
+// RequestContext 恢复被 HTTP Transport 剥离的取消，仅影响请求拥有的 DNS 拨号。
+func RequestContext(ctx context.Context) context.Context {
+	if state, ok := ctx.Value(requestContextKey{}).(*requestContextState); ok {
+		return state.ctx
+	}
+	return nil
+}
+
+// RequestTask 在派生工作开始前登记，普通共享 DNS 不需要等待。
+func RequestTask(ctx context.Context) func() {
+	state, ok := ctx.Value(requestContextKey{}).(*requestContextState)
+	if !ok {
+		return func() {}
+	}
+	state.mu.Lock()
+	defer state.mu.Unlock()
+	if state.closed {
+		return func() {}
+	}
+	state.tasks.Add(1)
+	return state.tasks.Done
+}
+
+// BindRequestContext 衔接 HTTP/QUIC 保留的值，并保留当前子操作自己的取消和超时。
+func BindRequestContext(ctx context.Context) (context.Context, func()) {
+	request := RequestContext(ctx)
+	if request == nil {
+		return ctx, func() {}
+	}
+	ctx, cancel := context.WithCancel(ctx)
+	stop := context.AfterFunc(request, cancel)
+	if request.Err() != nil {
+		cancel()
+	}
+	return ctx, func() { stop(); cancel() }
+}
+
+type requestConn struct {
+	net.Conn
+	once sync.Once
+	finish func()
+	err error
+}
+
+func (conn *requestConn) Close() error {
+	conn.once.Do(func() {
+		conn.err = conn.Conn.Close()
+		conn.finish()
+	})
+	return conn.err
+}
+
+// OwnRequestConn 让请求结束关闭它新建的 DNS 连接，包括 HTTP Transport 后续的 TLS 握手。
+func OwnRequestConn(ctx context.Context, conn net.Conn) net.Conn {
+	request := RequestContext(ctx)
+	if request == nil {
+		return conn
+	}
+	owned := &requestConn{Conn: conn, finish: RequestTask(ctx)}
+	context.AfterFunc(request, func() { _ = owned.Close() })
+	return owned
+}
+
+type requestPacketConn struct {
+	net.PacketConn
+	once sync.Once
+	finish func()
+	err error
+}
+
+func (conn *requestPacketConn) Close() error {
+	conn.once.Do(func() {
+		conn.err = conn.PacketConn.Close()
+		conn.finish()
+	})
+	return conn.err
+}
+
+// OwnRequestPacketConn 让请求新建的 DoQ/HTTP3 UDP 出站服从同一个资源生命周期。
+func OwnRequestPacketConn(ctx context.Context, conn net.PacketConn) net.PacketConn {
+	request := RequestContext(ctx)
+	if request == nil {
+		return conn
+	}
+	owned := &requestPacketConn{PacketConn: conn, finish: RequestTask(ctx)}
+	context.AfterFunc(request, func() { _ = owned.Close() })
+	return owned
+}
