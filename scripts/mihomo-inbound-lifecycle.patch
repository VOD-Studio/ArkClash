+package auth
+
+import (
+	"sync"
+	"testing"
+
+	"github.com/metacubex/mihomo/component/auth"
+)
+
+func TestArkClashAuthenticatorPublication(t *testing.T) {
+	valid := auth.NewAuthenticator([]auth.AuthUser{{User: "user", Pass: "pass"}})
+	store := NewAuthStore(valid)
+	if got := store.Authenticator(); got != valid {
+		t.Fatal("initial authenticator changed")
+	}
+	var workers sync.WaitGroup
+	for i := 0; i < 4; i++ {
+		workers.Add(1)
+		go func() {
+			defer workers.Done()
+			for j := 0; j < 1000; j++ {
+				got := store.Authenticator()
+				if got != nil && !got.Verify("user", "pass") {
+					t.Error("published authenticator changed credentials")
+				}
+			}
+		}()
+	}
+	for i := 0; i < 1000; i++ {
+		store.SetAuthenticator(nil)
+		store.SetAuthenticator(valid)
+	}
+	workers.Wait()
+	store.SetAuthenticator(nil)
+	if store.Authenticator() != nil {
+		t.Fatal("nil authenticator was not published")
+	}
+}
