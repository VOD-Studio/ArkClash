+package log
+
+import (
+	"sync"
+	"testing"
+)
+
+func TestArkClashLevelPublication(t *testing.T) {
+	previous := Level()
+	defer SetLevel(previous)
+	SetLevel(SILENT)
+	var workers sync.WaitGroup
+	for i := 0; i < 4; i++ {
+		workers.Add(1)
+		go func() {
+			defer workers.Done()
+			for j := 0; j < 1000; j++ {
+				current := Level()
+				if current != SILENT && current != ERROR {
+					t.Errorf("unexpected published level: %v", current)
+				}
+				print(Event{LogLevel: DEBUG, Payload: "filtered"})
+			}
+		}()
+	}
+	for i := 0; i < 1000; i++ {
+		SetLevel(ERROR)
+		SetLevel(SILENT)
+	}
+	workers.Wait()
+	SetLevel(INFO)
+	if Level() != INFO {
+		t.Fatal("level did not preserve SetLevel semantics")
+	}
+}
