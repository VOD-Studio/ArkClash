+package inbound
+
+import (
+	"errors"
+	"net"
+	"sync"
+	"sync/atomic"
+)
+
+var arkClashListenerOwnership atomic.Bool
+
+// EnableArkClashListenerOwnership 仅影响此后创建的监听器；Close 同步关闭已接受的原始连接。
+func EnableArkClashListenerOwnership() {
+	arkClashListenerOwnership.Store(true)
+}
+
+type arkClashListener struct {
+	net.Listener
+	mu        sync.Mutex
+	accepting sync.WaitGroup
+	closing   bool
+	conns     map[*arkClashConn]struct{}
+	errs      []error
+	once      sync.Once
+	err       error
+}
+
+func newArkClashListener(listener net.Listener) *arkClashListener {
+	return &arkClashListener{Listener: listener, conns: make(map[*arkClashConn]struct{})}
+}
+
+// ArkClashOwnListener 为直接创建的业务监听器复用同一所有权边界；未启用时返回原对象。
+func ArkClashOwnListener(listener net.Listener) net.Listener {
+	if !arkClashListenerOwnership.Load() {
+		return listener
+	}
+	if _, owned := listener.(*arkClashListener); owned {
+		return listener
+	}
+	return newArkClashListener(listener)
+}
+
+func (l *arkClashListener) Accept() (net.Conn, error) {
+	l.mu.Lock()
+	if l.closing {
+		l.mu.Unlock()
+		return nil, net.ErrClosed
+	}
+	l.accepting.Add(1)
+	l.mu.Unlock()
+	defer l.accepting.Done()
+
+	conn, err := l.Listener.Accept()
+	l.mu.Lock()
+	if err != nil {
+		l.mu.Unlock()
+		return nil, err
+	}
+	var socket *arkClashConn
+	var result net.Conn
+	if tcp, ok := conn.(*net.TCPConn); ok {
+		owned := &arkClashTCPConn{TCPConn: tcp, ownership: arkClashConn{Conn: conn, owner: l}}
+		socket, result = &owned.ownership, owned
+	} else {
+		socket = &arkClashConn{Conn: conn, owner: l}
+		result = socket
+	}
+	if l.closing {
+		l.mu.Unlock()
+		_ = socket.Close()
+		return nil, net.ErrClosed
+	}
+	l.conns[socket] = struct{}{}
+	l.mu.Unlock()
+	return result, nil
+}
+
+func (l *arkClashListener) Close() error {
+	l.once.Do(func() {
+		l.mu.Lock()
+		l.closing = true
+		l.mu.Unlock()
+		err := l.Listener.Close()
+		if errors.Is(err, net.ErrClosed) {
+			err = nil
+		}
+		// 阻止迟到的 Accept 越过清理边界；不能等待调用 Close 的业务处理器自身。
+		l.accepting.Wait()
+		l.mu.Lock()
+		conns := make([]*arkClashConn, 0, len(l.conns))
+		for conn := range l.conns {
+			conns = append(conns, conn)
+		}
+		l.mu.Unlock()
+		for _, conn := range conns {
+			_ = conn.Close()
+		}
+		l.mu.Lock()
+		l.err = errors.Join(append(l.errs, err)...)
+		l.mu.Unlock()
+	})
+	return l.err
+}
+
+type arkClashConn struct {
+	net.Conn
+	owner *arkClashListener
+	once  sync.Once
+	err   error
+}
+
+func (c *arkClashConn) Close() error {
+	c.once.Do(func() {
+		c.err = c.Conn.Close()
+		c.owner.mu.Lock()
+		delete(c.owner.conns, c)
+		if c.owner.closing && c.err != nil && !errors.Is(c.err, net.ErrClosed) {
+			c.owner.errs = append(c.owner.errs, c.err)
+		}
+		c.owner.mu.Unlock()
+	})
+	return c.err
+}
+
+func (c *arkClashConn) Upstream() any {
+	return c.Conn
+}
+
+// 保留原生 TCP 的半关闭、keepalive 和 syscall 能力，不额外分配关闭状态。
+type arkClashTCPConn struct {
+	*net.TCPConn
+	ownership arkClashConn
+}
+
+func (c *arkClashTCPConn) Close() error {
+	return c.ownership.Close()
+}
+
+func (c *arkClashTCPConn) Upstream() any {
+	return c.TCPConn
+}
