+package inbound
+
+import (
+	"context"
+	"errors"
+	"io"
+	"net"
+	"sync"
+	"testing"
+	"time"
+)
+
+func TestArkClashListenConfigOwnership(t *testing.T) {
+	if arkClashListenerOwnership.Load() {
+		t.Fatal("listener ownership must be opt-in")
+	}
+	lc := NewListenConfig()
+	plain, err := lc.Listen(context.Background(), "tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer plain.Close()
+	client, err := net.Dial("tcp", plain.Addr().String())
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer client.Close()
+	conn, err := plain.Accept()
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer conn.Close()
+	if err := plain.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := conn.Write([]byte("x")); err != nil {
+		t.Fatalf("default listener closed an accepted connection: %v", err)
+	}
+	if err := client.SetReadDeadline(time.Now().Add(2 * time.Second)); err != nil {
+		t.Fatal(err)
+	}
+	var data [1]byte
+	if _, err := io.ReadFull(client, data[:]); err != nil || data[0] != 'x' {
+		t.Fatalf("default accepted connection stopped working: %q, %v", data, err)
+	}
+
+	EnableArkClashListenerOwnership()
+	defer arkClashListenerOwnership.Store(false)
+	owned, err := lc.Listen(context.Background(), "tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer owned.Close()
+	client2, err := net.Dial("tcp", owned.Addr().String())
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer client2.Close()
+	conn2, err := owned.Accept()
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer conn2.Close()
+	if _, ok := conn2.(interface{ CloseWrite() error }); !ok {
+		t.Fatal("accepted TCP connection lost half-close support")
+	}
+	if err := owned.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if err := client2.SetReadDeadline(time.Now().Add(2 * time.Second)); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := client2.Read(data[:]); !errors.Is(err, io.EOF) {
+		t.Fatalf("raw pre-handshake connection remained open: %v", err)
+	}
+	if err := conn2.Close(); err != nil {
+		t.Fatalf("second connection close: %v", err)
+	}
+	if err := owned.Close(); err != nil {
+		t.Fatalf("second listener close: %v", err)
+	}
+}
+
+type arkClashTestConn struct {
+	net.Conn
+	closeErr error
+	closes   int
+}
+
+func (c *arkClashTestConn) Close() error {
+	c.closes++
+	_ = c.Conn.Close()
+	return c.closeErr
+}
+
+type arkClashTestListener struct {
+	net.Listener
+	started  chan struct{}
+	release  chan struct{}
+	closed   chan struct{}
+	conn     net.Conn
+	closeErr error
+	closes   int
+}
+
+func (l *arkClashTestListener) Accept() (net.Conn, error) {
+	close(l.started)
+	<-l.release
+	return l.conn, nil
+}
+
+func (l *arkClashTestListener) Close() error {
+	l.closes++
+	close(l.closed)
+	return l.closeErr
+}
+
+func TestArkClashListenerJoinsLateAcceptAndPreservesErrors(t *testing.T) {
+	a, b := net.Pipe()
+	defer b.Close()
+	connErr := errors.New("accepted socket close failure")
+	listenerErr := errors.New("listener close failure")
+	rawConn := &arkClashTestConn{Conn: a, closeErr: connErr}
+	raw := &arkClashTestListener{
+		started: make(chan struct{}), release: make(chan struct{}), closed: make(chan struct{}),
+		conn: rawConn, closeErr: listenerErr,
+	}
+	owned := newArkClashListener(raw)
+	accepted := make(chan error, 1)
+	go func() {
+		_, err := owned.Accept()
+		accepted <- err
+	}()
+	<-raw.started
+	closed := make(chan error, 1)
+	go func() { closed <- owned.Close() }()
+	<-raw.closed
+	select {
+	case err := <-closed:
+		t.Fatalf("Close did not join the in-flight Accept: %v", err)
+	default:
+	}
+	close(raw.release)
+	if err := <-accepted; !errors.Is(err, net.ErrClosed) {
+		t.Fatalf("late connection escaped closed listener: %v", err)
+	}
+	err := <-closed
+	if !errors.Is(err, listenerErr) || !errors.Is(err, connErr) {
+		t.Fatalf("cleanup lost close failures: %v", err)
+	}
+	if again := owned.Close(); again != err {
+		t.Fatalf("repeated close changed the result: %v", again)
+	}
+	if raw.closes != 1 || rawConn.closes != 1 {
+		t.Fatalf("repeated close touched released resources: listener=%d socket=%d", raw.closes, rawConn.closes)
+	}
+}
+
+func TestArkClashCompletedConnCloseErrorStaysWithConn(t *testing.T) {
+	a, b := net.Pipe()
+	defer b.Close()
+	connErr := errors.New("connection close failure")
+	raw := &arkClashTestConn{Conn: a, closeErr: connErr}
+	owner := newArkClashListener(&arkClashTestListener{closed: make(chan struct{})})
+	conn := &arkClashConn{Conn: raw, owner: owner}
+	owner.conns[conn] = struct{}{}
+	var workers sync.WaitGroup
+	for i := 0; i < 8; i++ {
+		workers.Add(1)
+		go func() {
+			defer workers.Done()
+			if err := conn.Close(); !errors.Is(err, connErr) {
+				t.Errorf("connection lost its close error: %v", err)
+			}
+		}()
+	}
+	workers.Wait()
+	if err := owner.Close(); err != nil {
+		t.Fatalf("completed connection prevented listener shutdown: %v", err)
+	}
+	if raw.closes != 1 || len(owner.conns) != 0 {
+		t.Fatalf("close did not release ownership once: closes=%d remaining=%d", raw.closes, len(owner.conns))
+	}
+}
