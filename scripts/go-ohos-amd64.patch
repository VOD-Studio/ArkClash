@@ -0,0 +1,62 @@
+// ArkClash OHOS：MOVQ TLS 的动态偏移解析，不依赖 musl 的静态 TLS 预留。
+// 每个入口只修改指定寄存器；TLSDESC 会改标志位，因此必须独立保存。
+	.section .tbss,"awT",@nobits
+	.p2align 3
+	.type arkclash_tls_g, @object
+	.size arkclash_tls_g, 8
+arkclash_tls_g:
+	.zero 8
+
+	.text
+	.macro TLS_OFFSET name, output, scratch
+	.p2align 4
+	.globl x_cgo_tls_\name
+	.hidden x_cgo_tls_\name
+	.type x_cgo_tls_\name, @function
+x_cgo_tls_\name:
+	.cfi_startproc
+	pushfq
+	.cfi_adjust_cfa_offset 8
+	push %\scratch
+	.cfi_adjust_cfa_offset 8
+	.cfi_offset %\scratch, -24
+	mov %rsp, %\scratch
+	.cfi_def_cfa %\scratch, 24
+	and $-16, %rsp
+	.ifnc \output,rax
+	xchg %rax, %\output
+	.endif
+	lea arkclash_tls_g@TLSDESC(%rip), %rax
+	call *arkclash_tls_g@TLSCALL(%rax)
+	.ifnc \output,rax
+	xchg %rax, %\output
+	.endif
+	mov %\scratch, %rsp
+	.cfi_def_cfa %rsp, 24
+	pop %\scratch
+	.cfi_restore %\scratch
+	.cfi_adjust_cfa_offset -8
+	popfq
+	.cfi_adjust_cfa_offset -8
+	ret
+	.cfi_endproc
+	.size x_cgo_tls_\name, .-x_cgo_tls_\name
+	.endm
+
+	TLS_OFFSET ax, rax, r11
+	TLS_OFFSET cx, rcx, r11
+	TLS_OFFSET dx, rdx, r11
+	TLS_OFFSET bx, rbx, r11
+	TLS_OFFSET bp, rbp, r11
+	TLS_OFFSET si, rsi, r11
+	TLS_OFFSET di, rdi, r11
+	TLS_OFFSET r8, r8, r11
+	TLS_OFFSET r9, r9, r11
+	TLS_OFFSET r10, r10, r11
+	TLS_OFFSET r11, r11, r10
+	TLS_OFFSET r12, r12, r11
+	TLS_OFFSET r13, r13, r11
+	TLS_OFFSET r14, r14, r11
+	TLS_OFFSET r15, r15, r11
+
+	.section .note.GNU-stack,"",@progbits
