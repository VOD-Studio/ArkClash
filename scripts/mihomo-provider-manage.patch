+package adapter
+
+import "fmt"
+
+// ArkClashRawDefinition 返回节点解析时的原始配置深拷贝；内置节点与策略组返回 nil。
+func (p *Proxy) ArkClashRawDefinition() map[string]any {
+	if p == nil || len(p.rawDefinition) == 0 {
+		return nil
+	}
+	return cloneRawMapping(p.rawDefinition)
+}
+
+func (p *Proxy) setArkClashRawDefinition(mapping map[string]any) {
+	p.rawDefinition = cloneRawMapping(mapping)
+}
+
+func cloneRawMapping(source map[string]any) map[string]any {
+	if source == nil {
+		return nil
+	}
+	result := make(map[string]any, len(source))
+	for key, value := range source {
+		result[key] = cloneRawValue(value)
+	}
+	return result
+}
+
+func cloneRawValue(value any) any {
+	switch typed := value.(type) {
+	case map[string]any:
+		return cloneRawMapping(typed)
+	case map[any]any:
+		result := make(map[string]any, len(typed))
+		for key, item := range typed {
+			result[fmt.Sprint(key)] = cloneRawValue(item)
+		}
+		return result
+	case []any:
+		result := make([]any, len(typed))
+		for i, item := range typed {
+			result[i] = cloneRawValue(item)
+		}
+		return result
+	case []string:
+		result := make([]string, len(typed))
+		copy(result, typed)
+		return result
+	default:
+		return value
+	}
+}
