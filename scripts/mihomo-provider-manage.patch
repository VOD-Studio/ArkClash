+package provider
+
+import "time"
+
+// ArkClashUpdate 执行远程更新并返回内容是否发生变化。
+func (pp *proxySetProvider) ArkClashUpdate() (bool, error) {
+	_, same, err := pp.Fetcher.Update()
+	return !same, err
+}
+
+// ArkClashReplace 使用已通过上层读取的候选字节执行原子校验与替换。
+func (pp *proxySetProvider) ArkClashReplace(buf []byte) (bool, error) {
+	_, same, err := pp.Fetcher.SideUpdate(buf)
+	return !same, err
+}
+
+func (pp *proxySetProvider) ArkClashUpdatedAt() time.Time {
+	return pp.Fetcher.ArkClashUpdatedAt()
+}
+
+func (ip *inlineProvider) ArkClashUpdatedAt() time.Time {
+	return ip.updateAt
+}
