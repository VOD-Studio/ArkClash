+package route
+
+import (
+ "context"
+ "errors"
+ "net"
+ "sync"
+
+ "github.com/metacubex/mihomo/adapter/inbound"
+ "github.com/metacubex/http"
+)
+
+// http.Server.Close 不关闭已劫持的 WebSocket；监听器持有全部已接受连接。
+type arkClashListener struct {
+ net.Listener
+ mu sync.Mutex
+ accepting sync.WaitGroup
+ closing bool
+ conns map[*arkClashConn]struct{}
+ errs []error
+ closeOnce sync.Once
+ closeErr error
+}
+
+type arkClashConn struct {
+ net.Conn
+ owner *arkClashListener
+ once sync.Once
+ err error
+}
+
+func (c *arkClashConn) Close() error {
+ c.once.Do(func() {
+  c.err = c.Conn.Close()
+  c.owner.mu.Lock()
+  delete(c.owner.conns, c)
+  if c.owner.closing && c.err != nil && !errors.Is(c.err, net.ErrClosed) { c.owner.errs = append(c.owner.errs, c.err) }
+  c.owner.mu.Unlock()
+ })
+ return c.err
+}
+
+func (l *arkClashListener) Accept() (net.Conn, error) {
+ l.mu.Lock()
+ if l.closing { l.mu.Unlock(); return nil, net.ErrClosed }
+ l.accepting.Add(1)
+ l.mu.Unlock()
+ defer l.accepting.Done()
+ conn, err := l.Listener.Accept()
+ if err != nil { return nil, err }
+ c := &arkClashConn{Conn: conn, owner: l}
+ l.mu.Lock()
+ if l.closing {
+  l.mu.Unlock()
+  _ = c.Close()
+  return nil, net.ErrClosed
+ }
+ l.conns[c] = struct{}{}
+ l.mu.Unlock()
+ return c, nil
+}
+
+func (l *arkClashListener) Close() error {
+ l.closeOnce.Do(func() {
+  l.mu.Lock()
+  l.closing = true
+  l.mu.Unlock()
+  err := l.Listener.Close()
+  if errors.Is(err, net.ErrClosed) { err = nil }
+  // 关闭 listener 后等待在途 Accept，避免迟到连接逃过本次清理。
+  if err == nil { l.accepting.Wait() }
+  l.mu.Lock()
+  conns := make([]*arkClashConn, 0, len(l.conns))
+  for c := range l.conns { conns = append(conns, c) }
+  l.mu.Unlock()
+  for _, c := range conns { _ = c.Close() }
+  l.mu.Lock()
+  l.closeErr = errors.Join(append(l.errs, err)...)
+  l.mu.Unlock()
+ })
+ return l.closeErr
+}
+
+var arkClashController struct {
+ sync.Mutex
+ server *http.Server
+ listener *arkClashListener
+ done chan struct{}
+ err error
+}
+
+func arkClashCloseServer() error {
+ if arkClashController.err != nil { return arkClashController.err }
+ if arkClashController.server == nil { return nil }
+ err := arkClashController.server.Close()
+ closeErr := arkClashController.listener.Close()
+ if closeErr == nil { <-arkClashController.done }
+ arkClashController.err = errors.Join(err, closeErr)
+ if arkClashController.err != nil { return arkClashController.err }
+ arkClashController.server = nil
+ arkClashController.listener = nil
+ arkClashController.done = nil
+ return nil
+}
+
+func ArkClashCloseServer() error {
+ arkClashController.Lock()
+ defer arkClashController.Unlock()
+ return arkClashCloseServer()
+}
+
+func ArkClashReCreateServer(cfg *Config) error {
+ arkClashController.Lock()
+ defer arkClashController.Unlock()
+ if err := arkClashCloseServer(); err != nil { return err }
+ if cfg == nil || cfg.Addr == "" { return nil }
+ if cfg.TLSAddr != "" || cfg.UnixAddr != "" || cfg.PipeAddr != "" { return errors.New("ArkClash controller requires HTTP only") }
+ lc := inbound.NewListenConfig()
+ lc.SetRouteMark(cfg.RoutingMark)
+ l, err := lc.Listen(context.Background(), "tcp", cfg.Addr)
+ if err != nil { return err }
+ owned := &arkClashListener{Listener: l, conns: map[*arkClashConn]struct{}{}}
+ s := &http.Server{Handler: router(cfg.IsDebug, cfg.Secret, cfg.DohServer, cfg.Cors)}
+ done := make(chan struct{})
+ arkClashController.server, arkClashController.listener, arkClashController.done = s, owned, done
+ go func() { defer close(done); _ = s.Serve(owned) }()
+ return nil
+}
+
+// ArkClashPanelRouter 由宿主限制路由及方法，并使用独立凭据。
+func ArkClashPanelRouter(secret string) http.Handler {
+ return router(false, secret, "", Cors{AllowOrigins: []string{"*"}, AllowPrivateNetwork: true})
+}
