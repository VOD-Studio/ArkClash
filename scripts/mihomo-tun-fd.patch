+package listener
+
+import (
+ "errors"
+ "fmt"
+ "sync"
+)
+
+type ArkClashListeners struct {
+ Inbound map[string]bool
+ TCPTunnels map[string]bool
+ UDPTunnels map[string]bool
+}
+
+func ArkClashListenerSnapshot() ArkClashListeners {
+ s := ArkClashListeners{Inbound: map[string]bool{}, TCPTunnels: map[string]bool{}, UDPTunnels: map[string]bool{}}
+ inboundMux.Lock()
+ for name := range inboundListeners { s.Inbound[name] = true }
+ inboundMux.Unlock()
+ tunnelMux.Lock()
+ for name := range tunnelTCPListeners { s.TCPTunnels[name] = true }
+ for name := range tunnelUDPListeners { s.UDPTunnels[name] = true }
+ tunnelMux.Unlock()
+ return s
+}
+
+var arkClashCloseMu sync.Mutex
+var arkClashCloseErrors = map[string]error{}
+
+func ArkClashCloseListeners() error {
+ arkClashCloseMu.Lock()
+ defer arkClashCloseMu.Unlock()
+ closeOne := func(name string, close func() error, clear func()) {
+  if arkClashCloseErrors[name] != nil { return }
+  if err := close(); err != nil { arkClashCloseErrors[name] = fmt.Errorf("%s: %w", name, err) } else { clear() }
+ }
+ httpMux.Lock()
+ if httpListener != nil { closeOne("httpListener", httpListener.Close, func() { httpListener = nil }) }
+ httpMux.Unlock()
+ socksMux.Lock()
+ if socksListener != nil { closeOne("socksListener", socksListener.Close, func() { socksListener = nil }) }
+ if socksUDPListener != nil { closeOne("socksUDPListener", socksUDPListener.Close, func() { socksUDPListener = nil }) }
+ socksMux.Unlock()
+ redirMux.Lock()
+ if redirListener != nil { closeOne("redirListener", redirListener.Close, func() { redirListener = nil }) }
+ if redirUDPListener != nil { closeOne("redirUDPListener", redirUDPListener.Close, func() { redirUDPListener = nil }) }
+ redirMux.Unlock()
+ tproxyMux.Lock()
+ if tproxyListener != nil { closeOne("tproxyListener", tproxyListener.Close, func() { tproxyListener = nil }) }
+ if tproxyUDPListener != nil { closeOne("tproxyUDPListener", tproxyUDPListener.Close, func() { tproxyUDPListener = nil }) }
+ tproxyMux.Unlock()
+ mixedMux.Lock()
+ if mixedListener != nil { closeOne("mixedListener", mixedListener.Close, func() { mixedListener = nil }) }
+ if mixedUDPLister != nil { closeOne("mixedUDPLister", mixedUDPLister.Close, func() { mixedUDPLister = nil }) }
+ mixedMux.Unlock()
+ ssMux.Lock()
+ if shadowSocksListener != nil { closeOne("shadowSocksListener", shadowSocksListener.Close, func() { shadowSocksListener = nil }) }
+ ssMux.Unlock()
+ vmessMux.Lock()
+ if vmessListener != nil { closeOne("vmessListener", vmessListener.Close, func() { vmessListener = nil }) }
+ vmessMux.Unlock()
+ tuicMux.Lock()
+ if tuicListener != nil { closeOne("tuicListener", tuicListener.Close, func() { tuicListener = nil }) }
+ tuicMux.Unlock()
+ inboundMux.Lock()
+ for name, entry := range inboundListeners { closeOne("inboundListeners/"+name, entry.Close, func() { delete(inboundListeners, name) }) }
+ inboundMux.Unlock()
+ tunnelMux.Lock()
+ for name, entry := range tunnelTCPListeners { closeOne("tunnelTCPListeners/"+name, entry.Close, func() { delete(tunnelTCPListeners, name) }) }
+ for name, entry := range tunnelUDPListeners { closeOne("tunnelUDPListeners/"+name, entry.Close, func() { delete(tunnelUDPListeners, name) }) }
+ tunnelMux.Unlock()
+ var errs []error
+ for _, err := range arkClashCloseErrors { errs = append(errs, err) }
+ return errors.Join(errs...)
+}
