+package dns
+
+import (
+ "errors"
+ "net"
+ "sync"
+)
+
+// miekg/dns 会忽略底层 Close 错误并重复关闭 listener；包装器记录真实结果且只释放一次。
+type arkClashListener struct {
+ net.Listener
+ once sync.Once
+ err error
+}
+func (l *arkClashListener) Close() error {
+ l.once.Do(func() { l.err = l.Listener.Close() })
+ return l.err
+}
+type arkClashPacketConn struct {
+ net.PacketConn
+ once sync.Once
+ err error
+}
+func (p *arkClashPacketConn) Close() error {
+ p.once.Do(func() { p.err = p.PacketConn.Close() })
+ return p.err
+}
+
+var arkClashDNSError error
+
+func arkClashCloseServer() error {
+ if arkClashDNSError != nil { return arkClashDNSError }
+ var errs []error
+ if server.tcpServer != nil {
+  err := server.tcpServer.Listener.(*arkClashListener).Close()
+  if err == nil { err = server.tcpServer.Shutdown(); if err == nil { <-server.tcpDone } }
+  if err != nil { errs = append(errs, err) } else { server.tcpServer = nil }
+ }
+ if server.udpServer != nil {
+  err := server.udpServer.PacketConn.(*arkClashPacketConn).Close()
+  if err == nil { err = server.udpServer.Shutdown(); if err == nil { <-server.udpDone } }
+  if err != nil { errs = append(errs, err) } else { server.udpServer = nil }
+ }
+ arkClashDNSError = errors.Join(errs...)
+ if arkClashDNSError == nil { address = "" }
+ return arkClashDNSError
+}
+
+func ArkClashCloseServer() error {
+ serverMu.Lock()
+ defer serverMu.Unlock()
+ return arkClashCloseServer()
+}
