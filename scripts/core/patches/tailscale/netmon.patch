 func DefaultRoute() (DefaultRouteDetails, error) {
+	if arkClashSubscribe != nil {
+		interfaces, err := GetInterfaceList()
+		if err != nil || len(interfaces) == 0 {
+			return DefaultRouteDetails{}, err
+		}
+		return DefaultRouteDetails{InterfaceName: interfaces[0].Name, InterfaceIndex: interfaces[0].Index}, nil
+	}
