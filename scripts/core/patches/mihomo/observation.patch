+package dns
+
+import (
+	"context"
+	"fmt"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	"github.com/metacubex/mihomo/common/lru"
+	"github.com/metacubex/mihomo/component/resolver"
+	icontext "github.com/metacubex/mihomo/context"
+
+	D "github.com/miekg/dns"
+)
+
+type QueryRecord struct {
+	Question  D.Question
+	Msg       *D.Msg
+	Initiator string
+	Upstream  string
+	Cached    bool
+	Start     time.Time
+	Err       error
+}
+
+type QueryNotify func(record QueryRecord)
+
+type queryObservation struct {
+	notify     QueryNotify
+	answeredBy *lru.LruCache[string, string]
+	mu         sync.Mutex
+}
+
+var queryObserver atomic.Pointer[queryObservation]
+var queryObserverMu sync.Mutex
+
+// 回调同步执行；不得在回调内更换 observer。停用返回后旧回调已退出。
+func SetQueryObserver(notify QueryNotify) {
+	queryObserverMu.Lock()
+	defer queryObserverMu.Unlock()
+	resolver.SetQueryObservationEnabled(false)
+	var next *queryObservation
+	if notify != nil {
+		next = &queryObservation{
+			notify: notify,
+			answeredBy: lru.New[string, string](lru.WithSize[string, string](4096)),
+		}
+	}
+	previous := queryObserver.Swap(next)
+	if previous != nil {
+		previous.mu.Lock()
+		previous.mu.Unlock()
+	}
+	if next != nil {
+		resolver.SetQueryObservationEnabled(true)
+	}
+}
+
+func queryInitiator(ctx context.Context) string {
+	switch initiator := resolver.InitiatorFrom(ctx); initiator {
+	case resolver.InitiatorApp, resolver.InitiatorRule, resolver.InitiatorDirect, resolver.InitiatorProxy, resolver.InitiatorOther:
+		return initiator
+	}
+	if _, ok := ctx.(*icontext.DNSContext); ok {
+		return resolver.InitiatorApp
+	}
+	return resolver.InitiatorOther
+}
+
+func answeredByKey(r *Resolver, q D.Question) string {
+	return fmt.Sprintf("%p %s", r, q.String())
+}
+
+func (r *Resolver) traceCacheHit(ctx context.Context, q D.Question, msg *D.Msg) {
+	observer := queryObserver.Load()
+	if observer == nil {
+		return
+	}
+	start := time.Now()
+	observer.mu.Lock()
+	defer observer.mu.Unlock()
+	if queryObserver.Load() != observer {
+		return
+	}
+	upstream, _ := observer.answeredBy.Get(answeredByKey(r, q))
+	observer.notify(QueryRecord{
+		Question: q,
+		Msg: msg,
+		Initiator: queryInitiator(ctx),
+		Upstream: upstream,
+		Cached: true,
+		Start: start,
+	})
+}
+
+type exchangeTrace struct {
+	observer  *queryObservation
+	resolver  *Resolver
+	question  D.Question
+	initiator string
+	start     time.Time
+
+	mu        sync.Mutex
+	upstreams map[*D.Msg]string
+}
+
+type exchangeTraceKey struct{}
+
+func (r *Resolver) traceExchange(ctx context.Context, q D.Question, initiator string, observer *queryObservation) (context.Context, *exchangeTrace) {
+	if observer == nil || queryObserver.Load() != observer {
+		return ctx, nil
+	}
+	trace := &exchangeTrace{
+		observer: observer,
+		resolver: r,
+		question: q,
+		initiator: initiator,
+		start: time.Now(),
+		upstreams: make(map[*D.Msg]string),
+	}
+	return context.WithValue(ctx, exchangeTraceKey{}, trace), trace
+}
+
+func traceAnswer(ctx context.Context, msg *D.Msg, upstream string) {
+	observer := queryObserver.Load()
+	if observer == nil || msg == nil {
+		return
+	}
+	trace, _ := ctx.Value(exchangeTraceKey{}).(*exchangeTrace)
+	if trace == nil || trace.observer != observer {
+		return
+	}
+	trace.mu.Lock()
+	if queryObserver.Load() == observer {
+		trace.upstreams[msg] = upstream
+	}
+	trace.mu.Unlock()
+}
+
+func (t *exchangeTrace) finish(msg *D.Msg, err error) {
+	if t == nil || queryObserver.Load() != t.observer {
+		return
+	}
+	observer := t.observer
+	observer.mu.Lock()
+	defer observer.mu.Unlock()
+	if queryObserver.Load() != observer {
+		return
+	}
+	record := QueryRecord{
+		Question: t.question,
+		Msg: msg,
+		Initiator: t.initiator,
+		Start: t.start,
+		Err: err,
+	}
+	if err == nil {
+		t.mu.Lock()
+		record.Upstream = t.upstreams[msg]
+		t.mu.Unlock()
+		if record.Upstream != "" {
+			observer.answeredBy.Set(answeredByKey(t.resolver, t.question), record.Upstream)
+		}
+	}
+	observer.notify(record)
+}
