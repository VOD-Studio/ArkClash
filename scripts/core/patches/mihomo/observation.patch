+package dns
+
+import (
+	"reflect"
+	"time"
+
+	"github.com/metacubex/mihomo/component/resolver"
+)
+
+// ClearAll 清理网络 DNS 缓存和连接，不清理 FakeIP 映射；并发查询仍可重新填充缓存。
+func ClearAll() {
+	var pending []*Resolver
+	for _, r := range []resolver.Resolver{resolver.DefaultResolver, resolver.SystemResolver} {
+		if rs, ok := r.(Resolvers); ok {
+			pending = append(pending, rs.Resolver, rs.ProxyResolver, rs.DirectResolver)
+		}
+	}
+	visited := make(map[*Resolver]struct{})
+	reset := make(map[dnsClient]struct{})
+	for len(pending) > 0 {
+		r := pending[len(pending)-1]
+		pending = pending[:len(pending)-1]
+		if r == nil {
+			continue
+		}
+		if _, done := visited[r]; done {
+			continue
+		}
+		visited[r] = struct{}{}
+		if r.cache != nil {
+			r.cache.Clear()
+		}
+		r.resetClients(reset)
+		pending = append(pending, r.defaultResolver)
+	}
+	if observer := queryObserver.Load(); observer != nil {
+		observer.answeredBy.Clear()
+	}
+}
+
+// 新增策略类型时必须补齐遍历，否则仅供策略使用的连接不会被清理。
+func (r *Resolver) resetClients(reset map[dnsClient]struct{}) {
+	for _, c := range r.main {
+		resetClientOnce(c, reset)
+	}
+	for _, c := range r.fallback {
+		resetClientOnce(c, reset)
+	}
+	for _, p := range r.policy {
+		switch p := p.(type) {
+		case domainTriePolicy:
+			p.Foreach(func(_ string, clients []dnsClient) bool {
+				for _, c := range clients {
+					resetClientOnce(c, reset)
+				}
+				return true
+			})
+		case domainMatcherPolicy:
+			for _, c := range p.dnsClients {
+				resetClientOnce(c, reset)
+			}
+		}
+	}
+}
+
+// 策略和主解析器可以共享包装后的底层传输，重复重置会关闭并发查询刚建立的连接。
+func resetClientOnce(c dnsClient, reset map[dnsClient]struct{}) {
+	for {
+		u, ok := c.(interface{ Unwrap() dnsClient })
+		if !ok {
+			break
+		}
+		c = u.Unwrap()
+	}
+	if reflect.TypeOf(c).Comparable() {
+		if _, done := reset[c]; done {
+			return
+		}
+		reset[c] = struct{}{}
+	}
+	if sc, ok := c.(*systemClient); ok {
+		sc.mu.Lock()
+		sc.lastFlush = time.Time{}
+		sc.mu.Unlock()
+	}
+	c.ResetConnection()
+}
