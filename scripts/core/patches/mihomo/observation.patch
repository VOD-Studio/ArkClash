+package statistic
+
+import "sync/atomic"
+
+// 观察者只在工具页可见时安装；不介入逐字节读写路径。
+type TrackerObserver struct {
+	Open  func(Tracker)
+	Close func(Tracker)
+}
+
+var trackerObserver atomic.Pointer[TrackerObserver]
+
+func SetTrackerObserver(observer *TrackerObserver) {
+	trackerObserver.Store(observer)
+}
+
+func notifyTrackerOpen(tracker Tracker) {
+	if observer := trackerObserver.Load(); observer != nil && observer.Open != nil {
+		observer.Open(tracker)
+	}
+}
+
+func notifyTrackerClose(tracker Tracker) {
+	if observer := trackerObserver.Load(); observer != nil && observer.Close != nil {
+		observer.Close(tracker)
+	}
+}
