+func (t *Tailscale) arkClashTailscaleLogin(ctx context.Context) (string, string, error) {
+	// 首次启动 tsnet 还会读取状态和初始化网卡。多个短时请求共享这一次启动。
+	t.loginStartOnce.Do(func() {
+		t.loginReady = make(chan struct{})
+		go func() {
+			defer close(t.loginReady)
+			_ = t.start()
+		}()
+	})
+	select {
+	case <-ctx.Done():
+		return "", "", ctx.Err()
+	case <-t.ctx.Done():
+		return "", "", t.ctx.Err()
+	case <-t.loginReady:
+	}
+	if t.startErr != nil {
+		return "", "", t.startErr
+	}
+	lc, err := t.server.LocalClient()
+	if err != nil {
+		return "", "", err
+	}
+	st, err := lc.StatusWithoutPeers(ctx)
+	if err != nil {
+		return "", "", err
+	}
+	switch st.BackendState {
+	case ipn.Running.String():
+		return "running", "", nil
+	case ipn.NeedsMachineAuth.String():
+		return "needs-approval", "", nil
+	}
+	if t.option.AuthKey != "" {
+		return "key-configured", "", nil
+	}
+	if st.AuthURL != "" {
+		return "authorize", st.AuthURL, nil
+	}
+	watcher, err := lc.WatchIPNBus(ctx, ipn.NotifyInitialState)
+	if err != nil {
+		return "", "", err
+	}
+	defer watcher.Close()
+	requested := false
+	for {
+		event, err := watcher.Next()
+		if err != nil {
+			return "", "", err
+		}
+		if event.State != nil {
+			switch *event.State {
+			case ipn.Running:
+				return "running", "", nil
+			case ipn.NeedsMachineAuth:
+				return "needs-approval", "", nil
+			}
+		}
+		if event.BrowseToURL != nil && *event.BrowseToURL != "" {
+			return "authorize", *event.BrowseToURL, nil
+		}
+		if !requested && event.State != nil && *event.State == ipn.NeedsLogin {
+			// 先订阅再触发登录，防止漏掉首次下发的地址。
+			if err := lc.StartLoginInteractive(ctx); err != nil {
+				return "", "", err
+			}
+			requested = true
+		}
+	}
+}
