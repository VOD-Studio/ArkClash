+// ArkClashTailscaleLogin 保留原适配器的生命周期，避免为浏览器授权另建节点身份。
+func (p *autoCloseProxyAdapter) ArkClashTailscaleLogin(ctx context.Context) (string, string, error) {
+	adapter := p.ProxyAdapter
+	if mux, ok := adapter.(*SingMux); ok {
+		adapter = mux.ProxyAdapter
+	}
+	login, ok := adapter.(interface {
+		arkClashTailscaleLogin(context.Context) (string, string, error)
+	})
+	if !ok {
+		return "", "", fmt.Errorf("Tailscale login unavailable")
+	}
+	defer runtime.KeepAlive(p)
+	return login.arkClashTailscaleLogin(ctx)
+}
