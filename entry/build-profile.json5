{
  "apiType": "stageMode",
  "buildOption": {
    "externalNativeOptions": {
      "path": "./src/main/cpp/CMakeLists.txt",
      "arguments": "",
      "cppFlags": "-std=c++17",
      // libclash.so (scripts/build-core.sh) is only built for arm64.
      "abiFilters": [
        "arm64-v8a"
      ]
    },
    "resOptions": {
      "copyCodeResource": {
        "enable": false
      }
    }
  },
  "targets": [
    {
      "name": "default"
    }
  ]
}
