{
  "apiType": "stageMode",
  "buildOption": {
    "externalNativeOptions": {
      "path": "./src/main/cpp/CMakeLists.txt",
      "arguments": "",
      "cppFlags": "-std=c++17",
      // 默认 ARM64；entry/hvigorfile.ts 按 ABI 环境变量覆盖编译与打包选项。
      "abiFilters": [
        "arm64-v8a"
      ]
    },
    "resOptions": {
      "copyCodeResource": {
        "enable": false
      }
    }
  },
  "targets": [
    {
      "name": "default"
    }
  ]
}
