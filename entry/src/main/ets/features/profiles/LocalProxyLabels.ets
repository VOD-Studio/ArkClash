export function proxyIssue(code: string): Resource {
  switch (code) {
    case 'local_proxy_name_empty': return $r('app.string.err_name_empty');
    case 'local_proxy_name_format': return $r('app.string.local_proxy_name_format');
    case 'local_proxy_name_reserved': return $r('app.string.local_proxy_name_reserved');
    case 'local_proxy_name_taken': return $r('app.string.local_proxy_name_taken');
    case 'local_proxy_port': return $r('app.string.local_proxy_port');
    case 'local_proxy_type': return $r('app.string.local_proxy_unsupported');
    case 'local_proxy_server_length': return $r('app.string.local_proxy_server_length');
    case 'local_proxy_required': return $r('app.string.local_proxy_required');
    case 'local_proxy_rejected': return $r('app.string.local_proxy_rejected');
    case 'local_proxy_input': return $r('app.string.local_proxy_input');
    case 'local_proxy_conflict': return $r('app.string.local_proxy_conflict');
    case 'local_proxy_core_unavailable': return $r('app.string.local_proxy_core_unavailable');
    case 'local_proxy_link': return $r('app.string.local_proxy_link');
    case 'local_proxy_map': return $r('app.string.local_proxy_map');
    case 'local_proxy_single_link': return $r('app.string.local_proxy_single_link');
    default: return $r('app.string.local_proxy_store');
  }
}
