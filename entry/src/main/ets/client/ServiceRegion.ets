function serviceIsAsciiUpper(code: string): boolean {
  for (let index = 0; index < code.length; index++) {
    const character = code.charCodeAt(index);
    if (character < 65 || character > 90) { return false; }
  }
  return true;
}

export function normalizeServiceRegion(input: string): string {
  // Go TrimSpace 包含 U+0085、不包含 BOM；简单大写不会把 ß 展开成 SS。
  const spaces = '[\\u0009-\\u000D \\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000]';
  const trimmed = input.replace(new RegExp('^' + spaces + '+|' + spaces + '+$', 'g'), '');
  const code = trimmed.toUpperCase();
  if (code.length !== trimmed.length) { return ''; }
  if (code.length === 2) { return serviceIsAsciiUpper(code) ? code : ''; }
  if (code.length !== 3 || !serviceIsAsciiUpper(code)) { return ''; }
  let low = 0;
  let high = ISO3166_PACKED.length / 5;
  while (low < high) {
    const mid = Math.floor((low + high) / 2);
    const entry = ISO3166_PACKED.substring(mid * 5, mid * 5 + 3);
    if (entry < code) { low = mid + 1; }
    else if (entry > code) { high = mid; }
    else { return ISO3166_PACKED.substring(mid * 5 + 3, mid * 5 + 5); }
  }
  return '';
}
