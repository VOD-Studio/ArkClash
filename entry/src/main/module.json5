{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "EntryAbility",
    "deviceTypes": [
      "phone",
      "tablet",
      "2in1"
    ],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    "metadata": [
      {
        // 应用级打开系统材质：分段按钮、开关、弹层等系统组件默认用沉浸光感（ADR-0007）。
        "name": "ohos.arkui.UIMaterial.state",
        "value": "enable"
      }
    ],
    "abilities": [
      {
        "name": "EntryAbility",
        "srcEntry": "./ets/entryability/EntryAbility.ets",
        "description": "$string:EntryAbility_desc",
        "icon": "$media:layered_image",
        "label": "$string:EntryAbility_label",
        "startWindowIcon": "$media:startIcon",
        "startWindowBackground": "$color:start_window_background",
        "launchType": "singleton",
        "exported": true,
        // 后台保持连接：用户开启后，连接期间申请数据传输长时任务（ADR-0038）。
        "backgroundModes": ["dataTransfer"],
        "skills": [
          {
            "entities": [
              "entity.system.home"
            ],
            "actions": [
              "ohos.want.action.home"
            ]
          },
          {
            "entities": ["entity.system.browsable"],
            "actions": ["ohos.want.action.viewData"],
            "uris": [
              { "scheme": "clash", "host": "install-config" },
              { "scheme": "clashmeta", "host": "install-config" },
              { "scheme": "flclash", "host": "install-config" }
            ]
          }
        ]
      }
    ],
    "extensionAbilities": [
      {
        // Runs in its own process and hosts the mihomo core, so the proxy keeps
        // working when the UI is closed or killed.
        "name": "ClashVpnAbility",
        "srcEntry": "./ets/vpn/ClashVpnAbility.ets",
        "description": "$string:ClashVpnAbility_desc",
        "type": "vpn",
        "exported": false
      }
    ],
    "requestPermissions": [
      {
        "name": "ohos.permission.INTERNET"
      },
      {
        "name": "ohos.permission.GET_NETWORK_INFO"
      },
      {
        "name": "ohos.permission.KEEP_BACKGROUND_RUNNING"
      },
      {
        "name": "ohos.permission.USE_FRAUD_APP_PICKER"
      }
    ]
  }
}
